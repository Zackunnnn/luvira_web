# Midtrans Sandbox Keys (dapatkan dari https://dashboard.sandbox.midtrans.com)
# Masuk ke Settings > Access Keys untuk mendapatkan Server Key dan Client Key
# (OPSIONAL - jika kosong aplikasi tidak akan crash, namun fitur pembayaran Midtrans akan nonaktif)
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# 3. DATABASE (POSTGRES VIA PRISMA)
# ==========================================
# Digunakan untuk menyimpan data produk, copywriting, dan changelog
# Jika kosong, website masih bisa dibuild (graceful fallback ke mock data di store)
# Contoh format Neon Postgres:
# DATABASE_URL="postgresql://user:password@ep-cool-butterfly-1234.us-east-2.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL=

# ==========================================
# 4. CLOUDFLARE R2 (AWS S3 COMPATIBLE STORAGE)
# ==========================================
# Digunakan untuk mengunggah dan menyimpan foto produk dari admin CMS
# Jika kosong, admin hanya bisa menggunakan format URL eksternal
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME="luvira-images"
# NEXT_PUBLIC_R2_URL="https://pub-xxxxxx.r2.dev"

# Payment mode toggle:
# - 'midtrans' = Midtrans Snap popup
# - 'sandbox'  = Simulasi lokal via SandboxPaymentModal (tidak hit API Midtrans)
NEXT_PUBLIC_PAYMENT_MODE=midtrans

# Midtrans Environment toggle:
# - 'sandbox' = Menggunakan sandbox endpoint
# - 'production' = Menggunakan production endpoint
NEXT_PUBLIC_MIDTRANS_ENV=sandbox
