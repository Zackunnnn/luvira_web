# ==============================================================================
# Luvira 2.0 Environment Variables Template
# JANGAN MENULIS KREDENSIAL / RAHASIA ASLI DI FILE INI
# Salin file ini menjadi .env atau .env.local di server deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (PostgreSQL - Neon / Supabase)
# ------------------------------------------------------------------------------
# Database Pengembangan / Staging / Produksi
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require&channel_binding=require"

# Database Khusus Pengujian Otomatis (Wajib terpisah dari DATABASE_URL)
DATABASE_URL_TEST="postgresql://USER:PASSWORD@TEST_HOST:5432/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# String acak berkekuatan tinggi untuk menandatangani JWT session cookie 4 peran sistem
JWT_SECRET="your-high-entropy-jwt-secret-at-least-32-chars"

# Token otentikasi rahasia untuk trigger scheduled cron job (mis. expire orders)
CRON_SECRET="your-cron-secret-token"

# ------------------------------------------------------------------------------
# 3. PAYMENT GATEWAY (MIDTRANS)
# ------------------------------------------------------------------------------
# Mode Midtrans: 'mock' (simulasi lokal tanpa kunci), 'sandbox', atau 'production'
MIDTRANS_MODE="mock"

# Kredensial Midtrans (hanya dibutuhkan jika MIDTRANS_MODE='sandbox' atau 'production')
MIDTRANS_SERVER_KEY="Mid-server-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="Mid-client-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_ENV="sandbox"

# ------------------------------------------------------------------------------
# 4. SHIPPING ADAPTER (RAJAONGKIR V2 KOMERCE)
# ------------------------------------------------------------------------------
# Mode Pengiriman Ongkir: 'mock' (deterministik tanpa kuota/kunci) atau 'live'
SHIPPING_MODE="mock"
RAJAONGKIR_API_KEY="your-rajaongkir-v2-api-key"

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION (HOSTINGER SMTP)
# ------------------------------------------------------------------------------
# Mode Email: 'log' (mencatat ke konsol tanpa kirim email) atau 'smtp'
EMAIL_MODE="log"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="notifikasi@luvira.id"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Luvira Store <notifikasi@luvira.id>"

# ------------------------------------------------------------------------------
# 6. IMAGE STORAGE (IMAGEKIT)
# ------------------------------------------------------------------------------
# Mode Gambar: 'imagekit' atau 'local-stub' (di lingkungan pengujian)
IMAGE_STORAGE_MODE="imagekit"
IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxx"
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxx"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/xxxxxx"

# ------------------------------------------------------------------------------
# 7. STOREFRONT & TAX CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_WA="6281234567890"
NEXT_PUBLIC_PPN_RATE="11"
