# ==============================================================================
# Luvira Environment Variables Template
# JANGAN MENULIS KREDENSIAL / RAHASIA ASLI DI FILE INI
# Salin file ini menjadi .env atau .env.local di server deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (Prisma ORM)
# ------------------------------------------------------------------------------
# Hostinger Managed MySQL format:
# DATABASE_URL="mysql://username:password@hostname:3306/database_name?connection_limit=5"
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?connection_limit=5"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
# String acak berkekuatan tinggi untuk menandatangani JWT session cookie admin/owner
JWT_SECRET="your-high-entropy-jwt-secret-at-least-32-chars"

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Server key dari Midtrans Dashboard (rahasia, hanya dibaca server)
MIDTRANS_SERVER_KEY="your-midtrans-server-key"

# Client key dari Midtrans Dashboard (publik, dibaca browser Snap SDK)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="your-midtrans-client-key"

# Environment Midtrans: 'sandbox' atau 'production'
NEXT_PUBLIC_MIDTRANS_ENV="sandbox"

# ------------------------------------------------------------------------------
# 4. STOREFRONT CONFIGURATION
# ------------------------------------------------------------------------------
# Nomor WhatsApp Admin untuk konfirmasi pesanan (format internasional tanpa tanda +)
NEXT_PUBLIC_ADMIN_WA="6281234567890"

# Tarif Pajak Pertambahan Nilai (PPN) dalam persen (misal 11 untuk 11%)
NEXT_PUBLIC_PPN_RATE="11"

# Mode Pengiriman Ongkir: 'mock' (simulasi) atau 'live' (RajaOngkir)
SHIPPING_MODE="mock"
