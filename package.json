{
  "name": "luvira-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:rbac": "vitest run tests/rbac",
    "test:e2e:buyer": "playwright test tests/e2e/buyer",
    "test:e2e:admin": "playwright test tests/e2e/admin",
    "test:e2e:owner": "playwright test tests/e2e/owner",
    "test:e2e:developer": "playwright test tests/e2e/developer",
    "test:phase1": "npm run test:unit && npm run test:rbac && npm run test:integration",
    "test:phase2": "npm run test:phase1 && npm run test:e2e:buyer",
    "test:phase3": "npm run test:phase2 && npm run test:e2e:admin",
    "test:phase4": "npm run test:phase3 && npm run test:e2e:owner",
    "test:phase5": "npm run test:phase4 && npm run test:e2e:developer",
    "test:all": "npm run test:phase5",
    "seed": "tsx prisma/seed.ts",
    "seed:showcase": "tsx prisma/showcase-seed.ts",
    "demo:seed": "tsx prisma/demo-seed.ts",
    "verify": "npm run lint && tsc --noEmit && npm run build && npm run test:all"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "midtrans-client": "^1.4.3",
    "next": "^16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
