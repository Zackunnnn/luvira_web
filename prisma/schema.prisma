generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id
  name          String
  model         String
  price         Int
  originalPrice Int?
  rating        Float
  reviewsCount  Int
  badge         String?
  description   String   @db.Text
  features      String[] // Array of strings, supported natively by PostgreSQL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  costPrice     Int      @default(0) // Harga Pokok Penjualan (HPP) / Modal
  packingCost   Int      @default(0) // Biaya kardus, lakban, dll

  variants      ColorVariant[]
}

model ColorVariant {
  id        String   @id
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  hex       String
  imageUrl  String   @db.Text
  stock     Int

  @@index([productId])
}

model SiteContent {
  id        String   @id @default("singleton")
  hero      Json
  about     Json
  features  Json
  microcopy Json
  updatedAt DateTime @updatedAt
}

model ChangeLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String?
  fieldName   String
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  changedBy   String   @default("Admin")
  createdAt   DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("admin") // "admin" | "owner"
  createdAt    DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  customerName      String
  customerPhone     String
  customerAddress   String
  status            String      @default("menunggu_transfer")
  promoCodeId       String?
  shippingCourier   String?
  shippingCost      Int?
  ppnAmount         Int?
  paymentProofUrl   String?
  paymentDeadline   DateTime?
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime    @default(now())
  paymentMethod     String      @default("manual") // "manual" | "midtrans"
  midtransToken     String?     @db.Text
  
  items             OrderItem[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id])
  productId  String
  variantId  String
  quantity    Int
  priceEach   Int
  costEach    Int    @default(0) // Historikal HPP saat order terjadi
  packingEach Int    @default(0) // Historikal packing cost saat order terjadi
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  discountType     String    // "percentage" | "fixed"
  discountValue    Int
  resellerName     String?
  resellerWaNumber String?
  commissionType   String?   // "percentage" | "fixed"
  commissionValue  Int?
  quota            Int       @default(0)
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  isActive         Boolean   @default(true)
  isFreeShipping   Boolean   @default(false)
}

model Media {
  id           String   @id @default(cuid())
  originalName String
  fileName     String   @unique
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  originalPath String
  optimizedPath String
  thumbnailPath String?
  createdAt    DateTime @default(now())
}

